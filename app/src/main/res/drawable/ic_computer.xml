<?xml version="1.0" encoding="utf-8"?>
<!--
    PC 아이콘 — 런처 아이콘과 같은 그림(모니터 + 번개).

    원래는 안드로이드 기본 모니터 그림이었다. 앱 아이콘은 앤츠네스트 것으로
    바꿨는데 목록 안은 그대로라, 같은 앱 안에서 두 가지 얼굴이 섞여 보였다.

    24x24 를 그대로 쓴다 — 이 파일을 쓰는 자리가 여럿이라 좌표계를 바꾸면
    다른 화면에서 크기가 어긋난다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 화면 테두리와 받침. 안쪽을 비워 두어 번개가 그 위에 놓이게 한다. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M21,2L3,2c-1.1,0 -2,0.9 -2,2v12c0,1.1 0.9,2 2,2h7v2L8,20v2h8v-2h-2v-2h7c1.1,0 2,-0.9 2,-2L23,4c0,-1.1 -0.9,-2 -2,-2zM21,16L3,16L3,4h18v12z" />

    <!-- 번개 — 저지연 스트리밍이라는 성격을 그림 하나로 말한다. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M13.3,5.2L9.4,10.9h2.4l-1,3.9 3.9,-5.7h-2.4z" />
</vector>
