<?xml version="1.0" encoding="utf-8"?>
<!--
    앱 목록 — PC 목록과 같은 머리 모양으로 맞춘다.

    원래는 가운데 28sp 글자 하나가 제목 자리를 대신했다. 그 글자에는 PC 이름이
    들어가는데, 이 화면이 무엇을 고르는 자리인지는 어디에도 없었다.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ants_bg"
    android:fitsSystemWindows="true"
    tools:context=".AppView">

    <LinearLayout
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <!-- id 는 그대로 둔다 — AppView 가 여기에 PC 이름을 넣는다. -->
        <TextView
            android:id="@+id/appListText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:preferKeepClear="true"
            android:textColor="@color/ants_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/subtitle_app_list"
            android:textColor="@color/ants_text_faint"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/appHeaderDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/appHeader"
        android:background="@color/ants_divider" />

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/appHeaderDivider"
        android:gravity="center" />

</RelativeLayout>
