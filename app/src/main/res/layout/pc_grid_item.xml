<?xml version="1.0" encoding="utf-8"?>
<!--
    PC 한 대 — 앤츠톡 원격지원의 카드 행 모양.

    격자에 작은 정사각형을 늘어놓으면, PC 가 한두 대뿐인 보통의 경우에 화면
    왼쪽 위에 작은 카드 하나만 덩그러니 남는다. 앤츠톡 원격지원은 같은 상황을
    가로로 꽉 찬 행으로 보여준다 — 한 대여도 허전하지 않고, 이름이 길어도
    잘리지 않는다.

    id 는 그대로 둔다 — GenericGridAdapter 가 이 이름들로 값을 넣는다.
    grid_overlay(자물쇠·오프라인)와 grid_spinner 는 아이콘 위에 겹쳐 놓는다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="5dp"
    android:paddingTop="5dp"
    android:paddingEnd="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ants_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:id="@+id/grid_image_layout"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/ants_icon_box">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="3dp"
                android:layout_marginBottom="3dp"
                android:contentDescription="@null" />

            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/ants_accent" />
        </FrameLayout>

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ants_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</FrameLayout>
